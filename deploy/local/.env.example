POSTGRES_DB=expertise
POSTGRES_USER=expertise
POSTGRES_PASSWORD=changeme

# API
AUTH__MODE=apikey
AUTH__APIKEY=dev-api-key-change-me
ConnectionStrings__DefaultConnection=Host=pgbouncer;Port=6432;Database=expertise;Username=expertise;Password=changeme;No Reset On Close=true
ConnectionStrings__MigrationConnection=Host=postgres;Port=5432;Database=expertise;Username=expertise;Password=changeme

# Keyed integrity hash (ADR-020) — REQUIRED outside Development since #490
# (the API container runs as Production by default). Generate with
# `openssl rand -base64 32`, then run `dotnet run --project src/ExpertiseApi --
# rehash --force` once and schedule/run the `verify` verb (host cron — Compose
# has no native timer; see docs/operations/integrity-verification-runbook.md).
# Rollback overlay: INTEGRITY__REQUIREKEY=false restores the legacy unkeyed
# mode (temporary use only — unkeyed hashes are forgeable by a DB-level writer).
INTEGRITY__HMACKEY=
INTEGRITY__REQUIREKEY=true

# Aggregator up-sync (ADR-013) — spoke role only; leave disabled for a standalone
# instance. The hub credential must carry expertise.write.draft ONLY.
SYNC__ENABLED=false
SYNC__HUBURL=
SYNC__TOKENENDPOINT=
SYNC__CLIENTID=
SYNC__CLIENTSECRET=
