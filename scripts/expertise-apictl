#!/usr/bin/env bash
#
# expertise-apictl — daily-use service control wrapper for agent-expertise-api.
#
# Hides per-OS service-manager differences (systemctl --user, launchctl,
# sc.exe via WSL interop). Installed by scripts/install.sh; symlink it into
# your PATH manually if you want a global command.
#
# Usage:
#   expertise-apictl start|stop|restart|status
#   expertise-apictl logs [-f] [-n LINES]
#   expertise-apictl health
#   expertise-apictl reembed [--batch-size N]
#   expertise-apictl backup-init [--install-deps]
#   expertise-apictl backup [--output DIR] [--instance-id ID]
#   expertise-apictl restore ARTIFACT [--force-draft] [--i-accept-unsigned-backup]
#   expertise-apictl drafts [--json]
#   expertise-apictl review
#   expertise-apictl --help
#
# backup-init bootstraps the signed+encrypted backup surface (ADR-012):
# installs age/jq when missing (--install-deps), generates the ed25519
# signing key (ssh-keygen) and age identity under ~/.config/expertise-api/
# backup/, and writes backup.env. backup/restore orchestrate the ExpertiseApi
# backup/restore CLI verbs plus tar/gzip/age and ssh-keygen -Y signatures;
# see docs/operations/backup-restore-runbook.md.
#
# drafts lists the pending review queue (GET /expertise/drafts); review is
# the interactive approve/reject loop for a HUMAN reviewer (ADR-018/ADR-019).
# Both need a reviewer token carrying expertise.write.approve — set
# EXPERTISE_API_TOKEN or EXPERTISE_API_TOKEN_FILE (keep it distinct from any
# agent write.draft token). Base URL comes from EXPERTISE_API_URL.
#

set -euo pipefail

SERVICE="${EXPERTISE_API_SERVICE:-expertise-api}"
LABEL="${EXPERTISE_API_LABEL:-com.thesemicolon.expertise-api}"
HEALTH_URL="${EXPERTISE_API_URL:-http://127.0.0.1:8080}/health"
READY_URL="${EXPERTISE_API_URL:-http://127.0.0.1:8080}/health/ready"
READY_TIMEOUT="${EXPERTISE_API_READY_TIMEOUT:-30}"

log() { printf '[expertise-apictl] %s\n' "$1"; }
err() { printf '[expertise-apictl] ERROR: %s\n' "$1" >&2; exit 1; }

usage() { sed -n '2,33p' "$0" | sed 's/^# \{0,1\}//'; }

detect_os() {
  case "$(uname -s)" in
    Darwin) echo macos ;;
    Linux)
      if grep -qiE '(microsoft|wsl)' /proc/version 2>/dev/null && command -v sc.exe >/dev/null 2>&1; then
        echo wsl_to_windows
      else
        echo linux
      fi ;;
    *) err "unsupported OS: $(uname -s) — use expertise-apictl.ps1 on Windows" ;;
  esac
}

OS="$(detect_os)"

# ---------------------------------------------------------------------------
# Detect install scope from install.env. When scope=system on macOS the
# LaunchDaemon runs under launchd's system domain, which requires root for
# lifecycle operations. apictl does not support this transparently (it would
# need sudo + a different launchctl domain). Fail clearly so the operator
# knows to use the system launchctl commands directly.
# ---------------------------------------------------------------------------
_detect_install_scope() {
  local xdg_config install_env recorded
  xdg_config="${XDG_CONFIG_HOME:-${HOME}/.config}"
  install_env="${xdg_config}/expertise-api/install.env"
  if [[ -f "${install_env}" ]]; then
    recorded=$(grep -m1 '^EXPERTISE_API_SCOPE=' "${install_env}" \
               | sed 's/^EXPERTISE_API_SCOPE=//' 2>/dev/null || true)
    printf '%s' "${recorded}"
  else
    printf 'user'
  fi
}

# The system-scope guard applies to service-LIFECYCLE subcommands only —
# backup-init/backup/restore/reembed talk to the database and filesystem,
# and drafts/review talk plain HTTP — never to launchd, so they work fine
# against a --system install.
case "${1:-}" in
  backup-init|backup|restore|reembed|drafts|review) _lifecycle_cmd=0 ;;
  *)                          _lifecycle_cmd=1 ;;
esac

if [[ "${OS}" == "macos" && "${_lifecycle_cmd}" == "1" ]]; then
  _recorded_scope="$(_detect_install_scope)"
  if [[ "${_recorded_scope}" == "system" ]]; then
    cat >&2 <<'SYSTEM_SCOPE_MSG'
[expertise-apictl] ERROR: this install was configured with --system (LaunchDaemon).
Full apictl support for the system domain is a planned follow-up.
Use the equivalent system-domain launchctl commands directly (requires sudo):

  sudo launchctl print   system/com.thesemicolon.expertise-api
  sudo launchctl kickstart -k system/com.thesemicolon.expertise-api   # restart
  sudo launchctl bootout system/com.thesemicolon.expertise-api        # stop
  sudo launchctl bootstrap system /Library/LaunchDaemons/com.thesemicolon.expertise-api.plist  # start
SYSTEM_SCOPE_MSG
    exit 2
  fi
fi

# ---------------------------------------------------------------------------
# resolve_log_dir — determine the log directory for the current install.
#
# Precedence (highest to lowest):
#   1. EXPERTISE_API_LOG_DIR env var (explicit override, cheapest escape hatch)
#   2. ${XDG_CONFIG_HOME:-${HOME}/.config}/expertise-api/install.env written
#      by install.sh at install time (recorded-at-install; correct for
#      --prefix installs where log dir diverges from the OS default path)
#   3. OS-default path (backward-compat fallback for pre-existing installs
#      that predate the install.env file)
#
# The install.env file is written to a stable, non-prefix-dependent XDG
# config location so apictl can probe it without knowing which --prefix was
# used at install time. It contains plain key=value lines (no quoting, no
# subshells). We read it with grep+sed — never `source` — so we do not
# execute arbitrary shell from disk.
# ---------------------------------------------------------------------------
resolve_log_dir() {
  # Layer 1: explicit env override
  if [[ -n "${EXPERTISE_API_LOG_DIR:-}" ]]; then
    printf '%s' "${EXPERTISE_API_LOG_DIR}"
    return 0
  fi

  # Layer 2: recorded-at-install value from the stable XDG config location.
  local xdg_config install_env recorded
  xdg_config="${XDG_CONFIG_HOME:-${HOME}/.config}"
  install_env="${xdg_config}/expertise-api/install.env"
  if [[ -f "${install_env}" ]]; then
    recorded=$(grep -m1 '^EXPERTISE_API_LOG_DIR=' "${install_env}" \
               | sed 's/^EXPERTISE_API_LOG_DIR=//' 2>/dev/null || true)
    if [[ -n "${recorded}" ]]; then
      printf '%s' "${recorded}"
      return 0
    fi
  fi

  # Layer 3: OS default (preserves behaviour for installs without the file)
  case "${OS}" in
    macos)          printf '%s' "${HOME}/Library/Logs/expertise-api" ;;
    linux)          printf '%s' "${XDG_STATE_HOME:-${HOME}/.local/state}/expertise-api" ;;
    wsl_to_windows) printf '%s' "${HOME}/.local/state/expertise-api" ;;
  esac
}

cmd_start() {
  case "${OS}" in
    linux)          systemctl --user start "${SERVICE}.service" ;;
    macos)          launchctl kickstart "gui/$(id -u)/${LABEL}" ;;
    wsl_to_windows) sc.exe start "${SERVICE}" ;;
  esac
}

cmd_stop() {
  case "${OS}" in
    linux)          systemctl --user stop "${SERVICE}.service" ;;
    macos)
      # Use `launchctl kill SIGTERM` rather than `launchctl bootout`.
      # bootout UNREGISTERS the service from the launchd domain, causing
      # `kickstart` in cmd_start to fail with "No such process" (#284).
      #
      # kill SIGTERM signals the running process while leaving the service
      # registered. ASP.NET Core handles SIGTERM gracefully and exits 0.
      # The plist's KeepAlive dict has SuccessfulExit=false, so launchd
      # does NOT respawn after a clean exit — the service stays stopped
      # until an explicit `kickstart`. The subsequent cmd_start `kickstart`
      # therefore works because the registration is still live.
      #
      # If the service is not currently running, kill returns a non-zero
      # exit, which we swallow (same || true behaviour as the old bootout).
      launchctl kill SIGTERM "gui/$(id -u)/${LABEL}" 2>/dev/null || true ;;
    wsl_to_windows) sc.exe stop "${SERVICE}" ;;
  esac
}

cmd_restart() {
  case "${OS}" in
    macos)
      # launchctl bootout is asynchronous: a cmd_stop+sleep+cmd_start sequence
      # races and surfaces "Service is already loaded" or duplicate-spawns.
      # `kickstart -k -p` is the atomic primitive (kill existing, then print
      # the new PID, which blocks until the supervised process is spawned).
      # See: man launchctl (Sonoma+).
      launchctl kickstart -k -p "gui/$(id -u)/${LABEL}" ;;
    linux)
      # `systemctl --user restart` is itself atomic and synchronous; no need
      # to compose stop+sleep+start.
      systemctl --user restart "${SERVICE}.service" ;;
    wsl_to_windows)
      # No atomic restart primitive exposed by sc.exe over the WSL interop
      # boundary; the stop+sleep+start pattern remains correct here.
      cmd_stop; sleep 1; cmd_start ;;
  esac
  wait_for_ready
}

wait_for_ready() {
  # Block until /health/ready returns 200 or READY_TIMEOUT elapses.
  # Skippable for stub-service tests where no HTTP listener is wired up.
  if [[ "${EXPERTISE_API_SKIP_READY:-0}" == "1" ]]; then
    log "ready: skipped (EXPERTISE_API_SKIP_READY=1)"
    return 0
  fi
  if ! command -v curl >/dev/null 2>&1; then
    log "ready: WARNING — curl not found; readiness NOT verified (install curl, or set EXPERTISE_API_SKIP_READY=1 to silence)"
    return 0
  fi
  local deadline=$(( SECONDS + READY_TIMEOUT ))
  while (( SECONDS < deadline )); do
    if curl -fsS --max-time 2 "${READY_URL}" >/dev/null 2>&1; then
      log "ready: OK (${READY_URL})"
      return 0
    fi
    sleep 1
  done
  err "service did not reach ready state within ${READY_TIMEOUT}s at ${READY_URL}"
}

cmd_status() {
  case "${OS}" in
    linux)
      systemctl --user status --no-pager "${SERVICE}.service" || true ;;
    macos)
      if launchctl print "gui/$(id -u)/${LABEL}" 2>/dev/null \
          | awk '/^[[:space:]]*(state|pid|last exit code|program) =/ {print}'; then
        :
      else
        err "service not loaded — run scripts/install.sh"
      fi ;;
    wsl_to_windows)
      sc.exe query "${SERVICE}" ;;
  esac
}

cmd_logs() {
  local follow=0 lines=200
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -f|--follow) follow=1; shift ;;
      -n|--lines)  lines="${2:?}"; shift 2 ;;
      *) err "unknown logs flag: $1" ;;
    esac
  done
  case "${OS}" in
    linux)
      if (( follow == 1 )); then
        journalctl --user -u "${SERVICE}.service" -n "${lines}" -f
      else
        journalctl --user -u "${SERVICE}.service" -n "${lines}" --no-pager
      fi ;;
    macos)
      local log_dir logfile
      log_dir="$(resolve_log_dir)"
      logfile="${log_dir}/stdout.log"
      [[ -f "${logfile}" ]] || err "no log file at ${logfile}"
      if (( follow == 1 )); then
        tail -n "${lines}" -f "${logfile}"
      else
        tail -n "${lines}" "${logfile}"
      fi ;;
    wsl_to_windows)
      powershell.exe -NoProfile -Command \
        "Get-WinEvent -ProviderName '${SERVICE}' -MaxEvents ${lines} | Format-List" ;;
  esac
}

cmd_health() {
  command -v curl >/dev/null 2>&1 || err "curl not found"
  if curl -fsS --max-time 5 "${HEALTH_URL}"; then
    printf '\n'
    log "health: OK"
  else
    err "health check failed against ${HEALTH_URL}"
  fi
}

# ===========================================================================
# Draft review (issue #485, ADR-019).
#
# `drafts` lists the pending review queue; `review` is the interactive
# approve/reject loop — the human arm of the ADR-018 separation-of-duties
# control. Draft content is agent-written and untrusted: the server
# hygienizes it (ADR-008) but deliberately does NOT strip terminal control
# bytes, so everything rendered here passes through _sanitize_tty first.
#
# Token/URL resolution is env-only (EXPERTISE_API_TOKEN / _TOKEN_FILE /
# EXPERTISE_API_URL). Deliberately NOT read from
# ~/.config/expertise-api/secrets.env: install.sh owns that path for SERVER
# config (connection string), a different schema than the skill's client
# contract — see ADR-019.
# ===========================================================================

API_BASE="${EXPERTISE_API_URL:-http://127.0.0.1:8080}"

_resolve_api_token() {
  local tok=""
  if [[ -n "${EXPERTISE_API_TOKEN:-}" ]]; then
    tok="${EXPERTISE_API_TOKEN}"
  elif [[ -n "${EXPERTISE_API_TOKEN_FILE:-}" ]]; then
    [[ -f "${EXPERTISE_API_TOKEN_FILE}" && -r "${EXPERTISE_API_TOKEN_FILE}" ]] \
      || err "EXPERTISE_API_TOKEN_FILE points to a missing or unreadable file: ${EXPERTISE_API_TOKEN_FILE}"
    tok="$(tr -d '\r\n' < "${EXPERTISE_API_TOKEN_FILE}")"
  fi
  [[ -n "${tok}" ]] || err "no reviewer token — set EXPERTISE_API_TOKEN or EXPERTISE_API_TOKEN_FILE (an expertise.write.approve token, distinct from any agent write.draft token)"
  # Charset guard before splicing into the curl config file: inside curl's
  # double-quoted config values only \\ \" \t \n \r \v are escapes, '#'
  # starts a comment, and control bytes/whitespace would truncate the header.
  # Legitimate bearer tokens (JWT base64url, dev:{tenant}:{scopes}) contain
  # none of these — fail loudly instead of sending a corrupted header.
  # shellcheck disable=SC1003  # '\' below is a one-character backslash pattern, not a quote escape
  case "${tok}" in
    *[![:graph:]]*|*'"'*|*'\'*|*'#'*)
      err "token contains characters never valid in a bearer token (whitespace, control byte, quote, backslash, or '#') — check your token source" ;;
  esac
  printf '%s' "${tok}"
}

# _api_http_init — dependency checks + one 700-perm workdir for the curl
# config (bearer) and response-body files. The EXIT trap is registered ONCE
# here: bash replaces (not stacks) EXIT traps, and cmd_review calls _api_http
# many times per session — per-call traps would leave every earlier call's
# bearer-bearing config file behind. Like _apictl_workdir above, the dir
# variable is deliberately not local so the trap can expand it.
_api_http_init() {
  command -v curl    >/dev/null 2>&1 || err "curl not found"
  command -v jq      >/dev/null 2>&1 || err "jq not found (required for drafts/review)"
  command -v uuidgen >/dev/null 2>&1 || err "uuidgen not found (required for Idempotency-Key)"
  [[ -n "${_apictl_httpdir:-}" ]] && return 0
  # Explicit template: bare `mktemp -t prefix` differs between BSD and GNU
  # (same rationale as scripts/lib/release-consumer.sh).
  _apictl_httpdir="$(mktemp -d "${TMPDIR:-/tmp}/expertise-apictl-http.XXXXXX")"
  chmod 700 "${_apictl_httpdir}"
  _apictl_resp="${_apictl_httpdir}/resp.body"
  trap 'rm -rf "${_apictl_httpdir:-}"' EXIT
}

# _api_http METHOD PATH [JSON_BODY]
# Response body lands in ${_apictl_resp}; HTTP status in ${API_HTTP_STATUS}.
# Called as a plain command (never via $(...)) so both globals survive.
# The bearer travels via `curl --config` (a 600-perm file under the 700-perm
# workdir), NEVER argv — `ps` on a shared host must not see it (the skill's
# api_curl still leaks it that way; #486). The config file is removed
# immediately after each call; the EXIT trap is only the abnormal-exit
# backstop. NEVER add -v/--trace* to this curl invocation: curl verbose modes
# print the Authorization header in cleartext (standing ADR-019 constraint).
_api_http() {
  local method="$1" path="$2" body_json="${3:-}"
  _api_http_init
  local tok cfg status
  tok="$(_resolve_api_token)"
  cfg="${_apictl_httpdir}/curl.cfg"
  ( umask 077
    {
      printf 'header = "Authorization: Bearer %s"\n' "${tok}"
      printf 'header = "Accept: application/json"\n'
      if [[ "${method}" == "POST" ]]; then
        printf 'header = "Idempotency-Key: %s"\n' "$(uuidgen)"
        printf 'header = "Content-Type: application/json"\n'
      fi
    } > "${cfg}"
  )
  local curl_extra=()
  if [[ "${method}" == "POST" ]]; then
    curl_extra=(-X POST --data "${body_json}")
  fi
  if ! status="$(curl -sS --max-time 30 -o "${_apictl_resp}" -w '%{http_code}' \
                   --config "${cfg}" \
                   ${curl_extra[@]+"${curl_extra[@]}"} \
                   "${API_BASE}${path}")"; then
    rm -f "${cfg}"
    err "could not reach ${API_BASE}${path} — is the service running? (expertise-apictl status)"
  fi
  rm -f "${cfg}"
  API_HTTP_STATUS="${status}"
}

# _sanitize_tty — codepoint-aware terminal sanitizer (CWE-150 anti-spoofing).
# jq, not tr: byte-level `tr -d '\200-\237'` corrupts UTF-8 (0x80-0x9F are
# legitimate continuation bytes in ordinary punctuation). Drops, per line:
#   - C0 controls except tab (ESC breaks all 7-bit CSI/OSC/DCS sequences)
#   - DEL (0x7F, destructive backspace on some terminals)
#   - C1 (U+0080-U+009F: 8-bit CSI/OSC alternates)
#   - bidi/format overrides (U+200E/F, U+202A-202E, U+2066-2069) that can
#     visually reorder or mask reviewed text
# Residual gap (accepted, ADR-019): homoglyph/confusable spoofing.
_sanitize_tty() {
  jq -Rr 'explode
          | map(select(
              (. == 9)
              or ((. >= 32) and (. != 127)
                  and ((. < 128) or (. > 159))
                  and (. != 8206) and (. != 8207)
                  and ((. < 8234) or (. > 8238))
                  and ((. < 8294) or (. > 8297)))))
          | implode'
}

_check_base_url_scheme() {
  # A write.approve bearer is the most privileged token this script handles;
  # warn (non-fatal) when it would traverse a network in cleartext.
  case "${API_BASE}" in
    https://*) : ;;
    http://127.0.0.1*|http://localhost*|'http://[::1]'*) : ;;
    *) log "WARNING: non-loopback plain-http base URL (${API_BASE}) — the reviewer bearer token will traverse the network in cleartext" ;;
  esac
}

# _jwt_preflight TOKEN — advisory only (the server enforces real authz).
# Warns when the token looks service-shaped (sub == azp/client_id): ADR-018
# review expects a HUMAN credential; a service-shaped approve is not blocked
# server-side but is tagged non-human and audited (#484). Fails soft on
# anything that is not a decodable JWT (LocalDev dev:{tenant}:{scopes}
# tokens, opaque tokens) — never aborts the session.
_jwt_preflight() {
  local tok="$1" payload b64 rem claims sub azp
  case "${tok}" in *.*.*) : ;; *) return 0 ;; esac
  payload="$(printf '%s' "${tok}" | cut -d. -f2)"
  b64="$(printf '%s' "${payload}" | tr '_-' '/+')"
  rem=$(( ${#b64} % 4 ))
  case "${rem}" in 2) b64="${b64}==" ;; 3) b64="${b64}=" ;; esac
  # jq @base64d instead of the base64 CLI: macOS/BSD (-D) and GNU (-d)
  # disagree on flags; jq is already a hard dependency here.
  claims="$(printf '"%s"' "${b64}" | jq -r '@base64d' 2>/dev/null)" || claims=""
  [[ -n "${claims}" ]] || return 0
  sub="$(printf '%s' "${claims}" | jq -r '.sub // empty' 2>/dev/null)" || sub=""
  azp="$(printf '%s' "${claims}" | jq -r '.azp // .client_id // empty' 2>/dev/null)" || azp=""
  if [[ -n "${sub}" && -n "${azp}" && "${sub}" == "${azp}" ]]; then
    log "WARNING: reviewer token looks service-shaped (sub == azp/client_id) — ADR-018 expects a human reviewer; this approval will be tagged non-human and audited"
  fi
  return 0
}

# _fetch_drafts — GET /expertise/drafts into ${_apictl_resp} with friendly
# status handling shared by cmd_drafts and cmd_review.
_fetch_drafts() {
  _api_http GET "/expertise/drafts"
  case "${API_HTTP_STATUS}" in
    200) : ;;
    401|403) err "HTTP ${API_HTTP_STATUS} from GET /expertise/drafts — the token must carry expertise.write.approve" ;;
    *) err "HTTP ${API_HTTP_STATUS} from GET /expertise/drafts: $(_sanitize_tty < "${_apictl_resp}")" ;;
  esac
}

cmd_drafts() {
  local json_out=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --json) json_out=1; shift ;;
      *) err "unknown drafts flag: $1 (usage: expertise-apictl drafts [--json])" ;;
    esac
  done
  _check_base_url_scheme
  _fetch_drafts
  if (( json_out == 1 )); then
    cat "${_apictl_resp}"
    return 0
  fi
  local count
  count="$(jq 'length' "${_apictl_resp}")"
  if [[ "${count}" == "0" ]]; then
    log "review queue is empty"
    return 0
  fi
  # Hygienized fields are {contentClass,value,hygieneApplied} envelopes; the
  # delimiter wrapper is stripped for the table via each item's own _hygiene
  # delimiters. @tsv escapes embedded tabs/newlines inside field values.
  {
    printf 'ID\tSTATE\tTYPE\tSEV\tAUTHOR\tTITLE\n'
    jq -r '.[]
           | (._hygiene.delimiterOpen) as $o | (._hygiene.delimiterClose) as $c
           | [ .id, .reviewState, .entryType, .severity,
               (.authorPrincipal + (if .authorAgent then " (" + .authorAgent + ")" else "" end)),
               (.title.value | ltrimstr($o) | rtrimstr($c)) ]
           | @tsv' "${_apictl_resp}"
  } | _sanitize_tty | awk -F'\t' '{ printf "%-36s  %-8s  %-10s  %-8s  %-30s  %s\n", $1, $2, $3, $4, $5, $6 }'
  log "${count} entr$( [[ "${count}" == "1" ]] && printf 'y' || printf 'ies' ) in the queue (Draft + Rejected; 'review' iterates Draft only)"
}

# _render_draft ENTRY_JSON MODE — MODE is 'brief' (body truncated) or 'full'.
# Everything printed here is untrusted agent-authored content → _sanitize_tty.
_render_draft() {
  local entry="$1" mode="$2"
  jq -r --arg mode "${mode}" '
    (._hygiene.delimiterOpen) as $o | (._hygiene.delimiterClose) as $c
    | def uv: if . == null then "—" else (.value | ltrimstr($o) | rtrimstr($c)) end;
    (.body | uv) as $body
    | [
        "────────────────────────────────────────────────────────────",
        "Id:        \(.id)",
        "State:     \(.reviewState)    Type: \(.entryType)    Severity: \(.severity)",
        "Tenant:    \(.tenant)    Visibility: \(.visibility)",
        ("Author:    \(.authorPrincipal)" + (if .authorAgent then "    Agent: \(.authorAgent)" else "" end)),
        (if .originInstanceId then "Origin:    \(.originInstanceId)    OriginAuthor: " + (.originAuthorPrincipal | uv) else empty end),
        "Created:   \(.createdAt)    Updated: \(.updatedAt)",
        "Hygiene:   detectors=[\(._hygiene.detectors | join(","))]  applied(body)=[\(.body.hygieneApplied | join(","))]",
        "Domain:    \(.domain | uv)",
        ("Tags:      " + ((.tags // []) | map(uv) | join(", "))),
        ("Source:    \(.source | uv)" + (if .sourceVersion then " @ " + (.sourceVersion | uv) else "" end)),
        (if .rejectionReason then "PriorReject: " + (.rejectionReason | uv) else empty end),
        "Title:     \(.title | uv)",
        "",
        (if $mode == "full" or ($body | length) <= 500
         then $body
         else (($body | .[:500]) + "\n… [truncated — press v for the full body]") end)
      ]
    | .[]' <<< "${entry}" | _sanitize_tty
}

# _verify_unchanged ID EXPECTED_HASH — TOCTOU guard: a draft can be PATCHed
# between render and approve (it stays Draft, so xmin concurrency alone will
# not catch it — the reviewer would approve content they never saw).
# GET /expertise/{id} deliberately never surfaces Drafts, so the re-check
# re-fetches the drafts queue and compares the server-computed IntegrityHash.
_verify_unchanged() {
  local id="$1" expected="$2" current
  _fetch_drafts
  current="$(jq -r --arg id "${id}" '.[] | select(.id == $id) | .integrityHash // empty' "${_apictl_resp}")"
  if [[ -z "${current}" ]]; then
    log "entry ${id} is no longer in the review queue (reviewed elsewhere?) — action cancelled"
    return 1
  fi
  if [[ "${current}" != "${expected}" ]]; then
    log "WARNING: content of ${id} changed since it was displayed (integrity hash mismatch) — action cancelled; re-run review to see the current content"
    return 1
  fi
  return 0
}

_review_post() {
  # _review_post ID VERB JSON_BODY — shared approve/reject POST + outcome map.
  local id="$1" verb="$2" body="$3"
  _api_http POST "/expertise/${id}/${verb}" "${body}"
  case "${API_HTTP_STATUS}" in
    200) log "${verb}: OK (${id})"; return 0 ;;
    403) log "HTTP 403 — a principal may not ${verb} its own draft (ADR-018 separation of duties; expertise.admin is the audited break-glass)"; return 1 ;;
    409) log "HTTP 409 — entry is not in Draft state or a concurrent review won the race"; return 1 ;;
    *)   log "HTTP ${API_HTTP_STATUS} from ${verb}: $(_sanitize_tty < "${_apictl_resp}")"; return 1 ;;
  esac
}

_do_approve() {
  local id="$1" expected_hash="$2" vis confirm body
  printf 'visibility [P]rivate (default) / [S]hared: ' > /dev/tty
  read -r vis < /dev/tty || return 1
  case "${vis}" in
    s|S|shared|Shared)
      # Shared broadens blast radius from one tenant to every tenant —
      # explicit consequence-naming confirmation, distinct from the approve.
      printf 'Shared publishes this entry to EVERY tenant. Type "shared" to confirm: ' > /dev/tty
      read -r confirm < /dev/tty || return 1
      [[ "${confirm}" == "shared" ]] || { log "not confirmed — approve cancelled"; return 1; }
      body='{"visibility":"Shared"}' ;;
    ''|p|P|private|Private)
      body='{"visibility":"Private"}' ;;
    *) log "unrecognized visibility '${vis}' — approve cancelled"; return 1 ;;
  esac
  _verify_unchanged "${id}" "${expected_hash}" || return 1
  _review_post "${id}" "approve" "${body}"
}

_do_reject() {
  local id="$1" expected_hash="$2" reason body
  printf 'rejection reason (required, max 2000 chars): ' > /dev/tty
  read -r reason < /dev/tty || return 1
  [[ -n "${reason}" ]] || { log "a rejection reason is required — reject cancelled"; return 1; }
  if (( ${#reason} > 2000 )); then
    log "reason is ${#reason} chars (server cap is 2000) — reject cancelled"
    return 1
  fi
  body="$(jq -cn --arg r "${reason}" '{rejectionReason: $r}')"
  _verify_unchanged "${id}" "${expected_hash}" || return 1
  _review_post "${id}" "reject" "${body}"
}

cmd_review() {
  [[ $# -eq 0 ]] || err "review takes no arguments (usage: expertise-apictl review)"
  # Interactive-only: prompts read from /dev/tty (stdin stays free), so a
  # controlling terminal is required. [ -t 0 ] tests the wrong thing —
  # stdin may be redirected while /dev/tty is still available, and vice
  # versa. Exit 2 = precondition failure (script-output-conventions).
  if ! { exec 3<>/dev/tty; } 2>/dev/null; then
    printf '[expertise-apictl] ERROR: review is interactive and needs a controlling terminal — use "expertise-apictl drafts --json" for scripting\n' >&2
    exit 2
  fi
  exec 3>&-

  _check_base_url_scheme
  _api_http_init
  # Plain assignment (not inline substitution in an argument) so a token
  # failure aborts once, cleanly, under set -e.
  local tok
  tok="$(_resolve_api_token)"
  _jwt_preflight "${tok}"
  _fetch_drafts

  # Buffer once; ${_apictl_resp} is reused by every subsequent _api_http call.
  # Only Draft entries are actionable (approve/reject 409 on anything else);
  # Rejected entries in the queue are informational — see 'drafts'.
  local drafts_json count i entry id hash action
  drafts_json="$(jq -c '[ .[] | select(.reviewState == "Draft") ]' "${_apictl_resp}")"
  count="$(jq 'length' <<< "${drafts_json}")"
  if [[ "${count}" == "0" ]]; then
    log "no Draft entries to review"
    return 0
  fi
  log "${count} Draft entr$( [[ "${count}" == "1" ]] && printf 'y' || printf 'ies' ) to review"

  i=0
  while (( i < count )); do
    entry="$(jq -c ".[$i]" <<< "${drafts_json}")"
    id="$(jq -r '.id' <<< "${entry}")"
    hash="$(jq -r '.integrityHash // empty' <<< "${entry}")"
    printf '\n[%d/%d]\n' "$(( i + 1 ))" "${count}" > /dev/tty
    _render_draft "${entry}" brief > /dev/tty

    while :; do
      printf '[a]pprove  [r]eject  [s]kip  [v]iew full  [q]uit > ' > /dev/tty
      # read fails on EOF (ctrl-d); under set -e a bare read in a loop body
      # would abort the whole script — always guard it.
      if ! read -r action < /dev/tty; then
        printf '\n' > /dev/tty
        log "EOF on /dev/tty — exiting review"
        return 0
      fi
      case "${action}" in
        a|A) if _do_approve "${id}" "${hash}"; then break; fi ;;
        r|R) if _do_reject  "${id}" "${hash}"; then break; fi ;;
        s|S) break ;;
        v|V) _render_draft "${entry}" full > /dev/tty ;;
        q|Q) log "review ended (${i} of ${count} reached)"; return 0 ;;
        *)   printf 'unrecognized action: %s\n' "${action}" > /dev/tty ;;
      esac
    done
    # NEVER a bare ((i++)) here: as a standalone command it returns the
    # truthiness of the OLD value, so incrementing from 0 aborts under
    # set -e on bash 4/5 (while passing on macOS bash 3.2).
    i=$(( i + 1 ))
  done
  log "review queue done (${count} entr$( [[ "${count}" == "1" ]] && printf 'y' || printf 'ies' ) presented)"
}

# ===========================================================================
# Backup / restore orchestration (ADR-012).
#
# Division of labour: the ExpertiseApi `backup`/`restore` CLI verbs own
# NDJSON + Merkle + manifest; these subcommands own tar/gzip/age signing and
# key/dependency bootstrap. Trust posture: `ssh-keygen -Y sign/verify` with a
# dedicated passwordless ed25519 key (ADR-012 Amendment 1 — cosign's v3 CLI
# removed the stable offline detached-signature flow this path needs; OpenSSH
# signatures are ubiquitous, offline, and CLI-stable). The allowed_signers
# file, not any transparency log, is the trust root. Config values are read
# with grep+sed, never sourced (same posture as install.env above).
# ===========================================================================

BACKUP_CONFIG_DIR="${EXPERTISE_API_BACKUP_CONFIG:-${XDG_CONFIG_HOME:-${HOME}/.config}/expertise-api/backup}"
BACKUP_ENV_FILE="${BACKUP_CONFIG_DIR}/backup.env"
SECRETS_FILE_DEFAULT="${XDG_CONFIG_HOME:-${HOME}/.config}/expertise-api/secrets.env"

_backup_env_get() {
  # _backup_env_get KEY — plain key=value read, no shell execution.
  [[ -f "${BACKUP_ENV_FILE}" ]] || return 0
  grep -m1 "^$1=" "${BACKUP_ENV_FILE}" | sed "s/^$1=//" 2>/dev/null || true
}

_sha256_file() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | awk '{print $1}'
  else
    shasum -a 256 "$1" | awk '{print $1}'
  fi
}

_backup_missing_deps() {
  # ssh-keygen ships with OpenSSH on every supported OS; it is listed anyway
  # so a pathological minimal container gets an actionable error.
  local missing=""
  for tool in ssh-keygen age age-keygen jq tar gzip; do
    command -v "${tool}" >/dev/null 2>&1 || missing="${missing} ${tool}"
  done
  printf '%s' "${missing# }"
}

_resolve_bin_dir() {
  # Precedence: env override -> install.env prefix -> install.sh default.
  if [[ -n "${EXPERTISE_API_BIN_DIR:-}" ]]; then
    printf '%s' "${EXPERTISE_API_BIN_DIR}"
    return 0
  fi
  local xdg_config install_env prefix
  xdg_config="${XDG_CONFIG_HOME:-${HOME}/.config}"
  install_env="${xdg_config}/expertise-api/install.env"
  if [[ -f "${install_env}" ]]; then
    prefix=$(grep -m1 '^EXPERTISE_API_PREFIX=' "${install_env}" \
             | sed 's/^EXPERTISE_API_PREFIX=//' 2>/dev/null || true)
    if [[ -n "${prefix}" ]]; then
      printf '%s' "${prefix}/bin"
      return 0
    fi
  fi
  printf '%s' "${HOME}/.local/share/expertise-api/bin"
}

_resolve_secrets_file() {
  # _resolve_secrets_file PREFIX — precedence: env override -> the SECRETS_FILE
  # recorded in the install's launch wrapper (the single source of truth for
  # the RUNNING service; installs with a custom --prefix/--config-dir put
  # secrets.env outside the XDG default) -> XDG default.
  local prefix="$1" wrapper recorded
  if [[ -n "${EXPERTISE_API_SECRETS_FILE:-}" ]]; then
    printf '%s' "${EXPERTISE_API_SECRETS_FILE}"
    return 0
  fi
  wrapper="${prefix}/launch-expertise-api.sh"
  if [[ -f "${wrapper}" ]]; then
    recorded=$(grep -m1 '^SECRETS_FILE=' "${wrapper}" \
               | sed 's/^SECRETS_FILE=//; s/^"//; s/"$//' 2>/dev/null || true)
    if [[ -n "${recorded}" ]]; then
      printf '%s' "${recorded}"
      return 0
    fi
  fi
  printf '%s' "${SECRETS_FILE_DEFAULT}"
}

_run_api_verb() {
  # _run_api_verb VERB [ARGS...] — source secrets + mirror the launch
  # wrapper's env (same rationale as scripts/migrate.sh: the DI graph must
  # match the runtime graph, and the connection string only lives in
  # secrets.env), then invoke the installed binary.
  local bin_dir prefix secrets_file
  bin_dir="$(_resolve_bin_dir)"
  prefix="$(dirname "${bin_dir}")"
  secrets_file="$(_resolve_secrets_file "${prefix}")"

  if [[ -f "${secrets_file}" ]]; then
    set -a
    # shellcheck disable=SC1090
    . "${secrets_file}"
    set +a
  else
    log "WARNING: no secrets file at ${secrets_file} — relying on environment"
  fi

  export ASPNETCORE_ENVIRONMENT="${ASPNETCORE_ENVIRONMENT:-Production}"
  export Onnx__ModelPath="${Onnx__ModelPath:-${prefix}/models/model.onnx}"
  export Onnx__VocabPath="${Onnx__VocabPath:-${prefix}/models/vocab.txt}"

  local conn="${ConnectionStrings__DefaultConnection:-}"
  [[ -n "${conn}" ]] || err "ConnectionStrings__DefaultConnection is not set — edit ${secrets_file} first"
  [[ "${conn}" != *CHANGE_ME* ]] || err "ConnectionStrings__DefaultConnection still contains CHANGE_ME — edit ${secrets_file} first"

  if [[ -x "${bin_dir}/ExpertiseApi" ]]; then
    "${bin_dir}/ExpertiseApi" "$@"
  elif [[ -f "${bin_dir}/ExpertiseApi.dll" ]]; then
    command -v dotnet >/dev/null 2>&1 || err "dotnet CLI not found (required for fdd layout at ${bin_dir})"
    dotnet "${bin_dir}/ExpertiseApi.dll" "$@"
  else
    err "no ExpertiseApi binary at ${bin_dir} — run scripts/install.sh first (or set EXPERTISE_API_BIN_DIR)"
  fi
}

_backup_preflight() {
  # Validates the whole backup surface with actionable errors. Every failure
  # points at backup-init, which fixes all of them.
  local missing
  missing="$(_backup_missing_deps)"
  [[ -z "${missing}" ]] || err "missing tools:${missing:+ }${missing} — run: expertise-apictl backup-init --install-deps"
  [[ -f "${BACKUP_ENV_FILE}" ]] || err "no backup config at ${BACKUP_ENV_FILE} — run: expertise-apictl backup-init"

  SIGNING_KEY_FILE="$(_backup_env_get SIGNING_KEY)"
  ALLOWED_SIGNERS_FILE="$(_backup_env_get ALLOWED_SIGNERS)"
  AGE_IDENTITY_FILE="$(_backup_env_get AGE_IDENTITY)"
  AGE_RECIPIENTS_FILE="$(_backup_env_get AGE_RECIPIENTS)"
  BACKUP_OUTPUT_DIR="$(_backup_env_get OUTPUT_DIR)"

  for pair in "SIGNING_KEY:${SIGNING_KEY_FILE}" "ALLOWED_SIGNERS:${ALLOWED_SIGNERS_FILE}" \
              "AGE_IDENTITY:${AGE_IDENTITY_FILE}" "AGE_RECIPIENTS:${AGE_RECIPIENTS_FILE}"; do
    local key="${pair%%:*}" val="${pair#*:}"
    [[ -n "${val}" ]] || err "${key} not set in ${BACKUP_ENV_FILE} — re-run: expertise-apictl backup-init"
    [[ -f "${val}" ]] || err "${key} points at missing file ${val} — re-run: expertise-apictl backup-init"
  done
}

cmd_backup_init() {
  local install_deps=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --install-deps) install_deps=1; shift ;;
      *) err "unknown backup-init flag: $1" ;;
    esac
  done

  local missing
  missing="$(_backup_missing_deps)"
  if [[ -n "${missing}" ]]; then
    if (( install_deps == 1 )); then
      case "${OS}" in
        macos)
          command -v brew >/dev/null 2>&1 || err "Homebrew required for --install-deps on macOS (https://brew.sh)"
          local brew_pkgs=""
          for tool in ${missing}; do
            case "${tool}" in
              age-keygen) [[ " ${brew_pkgs} " == *" age "* ]] || brew_pkgs="${brew_pkgs} age" ;;
              age)        [[ " ${brew_pkgs} " == *" age "* ]] || brew_pkgs="${brew_pkgs} age" ;;
              *)          brew_pkgs="${brew_pkgs} ${tool}" ;;
            esac
          done
          log "installing via brew:${brew_pkgs}"
          # shellcheck disable=SC2086
          brew install ${brew_pkgs} ;;
        linux|wsl_to_windows)
          command -v apt-get >/dev/null 2>&1 \
            || err "--install-deps supports apt-based distros (Debian/Ubuntu); install${missing} via your package manager and re-run"
          local apt_pkgs=""
          for tool in ${missing}; do
            case "${tool}" in
              age-keygen) [[ " ${apt_pkgs} " == *" age "* ]] || apt_pkgs="${apt_pkgs} age" ;;
              ssh-keygen) apt_pkgs="${apt_pkgs} openssh-client" ;;
              *) apt_pkgs="${apt_pkgs} ${tool}" ;;
            esac
          done
          log "installing via apt:${apt_pkgs}"
          # shellcheck disable=SC2086
          sudo apt-get install -y ${apt_pkgs} ;;
      esac
    else
      err "missing tools:${missing:+ }${missing} — re-run with --install-deps, or install them and re-run"
    fi
  fi

  mkdir -p "${BACKUP_CONFIG_DIR}"
  chmod 700 "${BACKUP_CONFIG_DIR}"

  local signing_key="${BACKUP_CONFIG_DIR}/backup_signing_key"
  local allowed_signers="${BACKUP_CONFIG_DIR}/allowed_signers"
  local age_identity="${BACKUP_CONFIG_DIR}/age-identity.txt"
  local age_recipients="${BACKUP_CONFIG_DIR}/age-recipients.txt"

  if [[ -f "${signing_key}" ]]; then
    log "signing key present at ${signing_key} (preserved — never regenerated silently)"
  else
    # Passwordless by design: `apictl backup` must run unattended (cron) and
    # `restore` must work mid-disaster with no interactive prompt. The key is
    # protected by 700/600 file permissions; rotate to a passphrase-protected
    # key only if you accept prompts on every sign.
    log "generating ed25519 signing key (passwordless, chmod 600)"
    ssh-keygen -t ed25519 -N "" -q -C "expertise-backup" -f "${signing_key}"
  fi
  chmod 600 "${signing_key}"

  if [[ ! -f "${allowed_signers}" ]]; then
    # ssh-keygen -Y verify trusts principals listed here — this file is the
    # backup trust root (ADR-012 Amendment 1). Format: "<principal> <keytype> <key>".
    printf 'expertise-backup %s\n' "$(cut -d' ' -f1-2 < "${signing_key}.pub")" > "${allowed_signers}"
  fi

  if [[ -f "${age_identity}" ]]; then
    log "age identity present at ${age_identity} (preserved)"
  else
    log "generating age identity (chmod 600)"
    age-keygen -o "${age_identity}" 2>/dev/null
  fi
  chmod 600 "${age_identity}"

  if [[ ! -f "${age_recipients}" ]]; then
    # Recipients file starts with this host's own public key; append a second
    # recipient (offline/escrow key) here so backups stay decryptable if this
    # host's identity is lost — see the runbook's key-discipline note.
    grep -m1 '^# public key: ' "${age_identity}" | sed 's/^# public key: //' > "${age_recipients}"
    [[ -s "${age_recipients}" ]] || err "could not extract public key from ${age_identity}"
  fi

  if [[ ! -f "${BACKUP_ENV_FILE}" ]]; then
    cat > "${BACKUP_ENV_FILE}" <<EOF
# backup.env — expertise-apictl backup configuration (ADR-012).
# Plain key=value; read with grep+sed, never sourced. chmod 600.
SIGNING_KEY=${signing_key}
ALLOWED_SIGNERS=${allowed_signers}
AGE_IDENTITY=${age_identity}
AGE_RECIPIENTS=${age_recipients}
OUTPUT_DIR=${HOME}/expertise-backups
EOF
    chmod 600 "${BACKUP_ENV_FILE}"
    log "wrote ${BACKUP_ENV_FILE}"
  else
    log "backup.env present at ${BACKUP_ENV_FILE} (preserved)"
  fi

  _backup_preflight
  log "backup-init: OK — keys in ${BACKUP_CONFIG_DIR}, artifacts will land in $(_backup_env_get OUTPUT_DIR)"
  log "IMPORTANT: back up ${age_identity} (losing it means losing your backups) and consider adding a second recipient to ${age_recipients}"
}

cmd_backup() {
  local output_override="" instance_id
  instance_id="$(hostname -s 2>/dev/null || uname -n)"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --output)      output_override="${2:?--output needs a directory}"; shift 2 ;;
      --instance-id) instance_id="${2:?--instance-id needs a value}"; shift 2 ;;
      *) err "unknown backup flag: $1" ;;
    esac
  done

  _backup_preflight
  local out_dir="${output_override:-${BACKUP_OUTPUT_DIR}}"
  mkdir -p "${out_dir}"

  # workdir is deliberately NOT local: the EXIT trap fires after the function's
  # locals are gone, and under `set -u` an out-of-scope expansion aborts the
  # trap with "unbound variable" (leaving the plaintext tempdir behind).
  local ts artifact
  _apictl_workdir="$(mktemp -d)"
  local workdir="${_apictl_workdir}"
  trap 'rm -rf "${_apictl_workdir:-}"' EXIT
  ts="$(date -u +%Y%m%dT%H%M%SZ)"
  artifact="${out_dir}/expertise-backup-${instance_id}-${ts}.tar"

  log "exporting via ExpertiseApi backup verb"
  _run_api_verb backup --output "${workdir}/payload" --instance-id "${instance_id}" \
    || err "export verb failed — nothing was signed or written to ${out_dir}"

  log "compressing + encrypting payload"
  tar -czf "${workdir}/payload.tar.gz" -C "${workdir}/payload" entries.jsonl audit.jsonl
  age -e -R "${AGE_RECIPIENTS_FILE}" -o "${workdir}/payload.tar.gz.age" "${workdir}/payload.tar.gz"
  rm -f "${workdir}/payload.tar.gz" "${workdir}/payload/entries.jsonl" "${workdir}/payload/audit.jsonl"

  # Bind the encrypted payload to the manifest BEFORE signing, so the
  # signature covers the payload hash (ADR-012 manifest schema).
  local payload_sha
  payload_sha="$(_sha256_file "${workdir}/payload.tar.gz.age")"
  jq --arg sha "${payload_sha}" '. + {payloadSha256: $sha}' \
    "${workdir}/payload/manifest.json" > "${workdir}/manifest.json"

  log "signing manifest (ssh-keygen -Y, offline — allowed_signers is the trust root)"
  ssh-keygen -Y sign -f "${SIGNING_KEY_FILE}" -n expertise-backup -q \
    "${workdir}/manifest.json"

  tar -cf "${artifact}" -C "${workdir}" payload.tar.gz.age manifest.json manifest.json.sig
  chmod 600 "${artifact}"
  log "backup: OK — ${artifact}"
}

cmd_reembed() {
  # Pass-through to the ExpertiseApi reembed verb: regenerate every stored
  # embedding with the currently installed model. Idempotent and safe while
  # the service is running (per-batch row saves; reads tolerate NULL/stale
  # embeddings). REQUIRED once after a model-swap release (ADR-017) — until it
  # completes, pre-existing entries are invisible to semantic/hybrid search.
  _run_api_verb reembed "$@" || err "reembed verb failed — see log output above"
  log "reembed: OK"
}

cmd_restore() {
  local artifact="" force_draft=0 accept_unsigned=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --force-draft)              force_draft=1; shift ;;
      --i-accept-unsigned-backup) accept_unsigned=1; shift ;;
      -*) err "unknown restore flag: $1" ;;
      *)  [[ -z "${artifact}" ]] || err "multiple artifacts given"; artifact="$1"; shift ;;
    esac
  done
  [[ -n "${artifact}" ]] || err "usage: expertise-apictl restore ARTIFACT.tar [--force-draft] [--i-accept-unsigned-backup]"
  [[ -f "${artifact}" ]] || err "artifact not found: ${artifact}"

  _backup_preflight

  # See cmd_backup for why the trap variable must not be local.
  _apictl_workdir="$(mktemp -d)"
  local workdir="${_apictl_workdir}"
  trap 'rm -rf "${_apictl_workdir:-}"' EXIT

  # Member allowlist before extraction (ADR-011 tar-hardening posture): the
  # outer tar must contain exactly the three expected members, no paths.
  local members
  members="$(tar -tf "${artifact}")"
  if [[ "$(printf '%s\n' "${members}" | sort)" != "$(printf 'manifest.json\nmanifest.json.sig\npayload.tar.gz.age' | sort)" ]]; then
    err "unexpected artifact contents: $(printf '%s' "${members}" | tr '\n' ' ') — refusing to extract"
  fi
  tar -xf "${artifact}" -C "${workdir}"

  if (( accept_unsigned == 1 )); then
    log "WARNING: --i-accept-unsigned-backup — SKIPPING signature verification (dev escape hatch, ADR-012)"
  else
    log "verifying manifest signature (fail closed)"
    ssh-keygen -Y verify -f "${ALLOWED_SIGNERS_FILE}" \
      -I expertise-backup -n expertise-backup \
      -s "${workdir}/manifest.json.sig" \
      < "${workdir}/manifest.json" >/dev/null 2>&1 \
      || err "manifest signature verification FAILED — refusing to restore (pass --i-accept-unsigned-backup only if you understand ADR-012's trust policy)"
  fi

  log "verifying payload hash against manifest"
  local declared actual
  declared="$(jq -r '.payloadSha256 // empty' "${workdir}/manifest.json")"
  [[ -n "${declared}" ]] || err "manifest carries no payloadSha256 — artifact was not produced by 'expertise-apictl backup'"
  actual="$(_sha256_file "${workdir}/payload.tar.gz.age")"
  [[ "${declared}" == "${actual}" ]] || err "payload hash mismatch (manifest ${declared}, actual ${actual}) — refusing to restore"

  log "decrypting payload"
  age -d -i "${AGE_IDENTITY_FILE}" -o "${workdir}/payload.tar.gz" "${workdir}/payload.tar.gz.age"
  mkdir -p "${workdir}/payload"
  tar -xzf "${workdir}/payload.tar.gz" -C "${workdir}/payload"
  cp "${workdir}/manifest.json" "${workdir}/payload/manifest.json"

  log "importing via ExpertiseApi restore verb"
  local verb_args=(restore --input "${workdir}/payload" --mode replace)
  (( force_draft == 0 )) || verb_args+=(--force-draft)
  _run_api_verb "${verb_args[@]}" || err "restore verb failed — see log output above"
  log "restore: OK"
}

case "${1:-}" in
  start)      shift; cmd_start "$@" ;;
  stop)       shift; cmd_stop "$@" ;;
  restart)    shift; cmd_restart "$@" ;;
  status)     shift; cmd_status "$@" ;;
  logs)       shift; cmd_logs "$@" ;;
  health)     shift; cmd_health "$@" ;;
  backup-init) shift; cmd_backup_init "$@" ;;
  backup)     shift; cmd_backup "$@" ;;
  restore)    shift; cmd_restore "$@" ;;
  reembed)    shift; cmd_reembed "$@" ;;
  drafts)     shift; cmd_drafts "$@" ;;
  review)     shift; cmd_review "$@" ;;
  ''|-h|--help) usage ;;
  *) err "unknown subcommand: $1 (try --help)" ;;
esac
